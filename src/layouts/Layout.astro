---
// Layout.astro
const {
  title = "Document",
  description = "「伝えたい想い」をカタチに。ホームページ制作でお悩みの方へ、丁寧なヒアリングと提案で理想を実現します。まずはお気軽にお問い合わせください。",
  ogImage = "/ogp.png",
  lang = "ja",
  lp = false, // true: LP用のヘッダー・フッター（ナビなし）に差し替える
  lpCta = undefined, // lp のとき { header, sticky } でボタン文言を渡す
} = Astro.props;

// 現在のパス取得
const currentPath = Astro.url.pathname;
const isEnglish = lang === "en";

// 言語切替用URL生成
const getAlternateLanguageUrl = (targetLang: string) => {
  if (targetLang === "en") {
    // JA → EN: /en を追加
    return currentPath === '/' ? '/en/' : `/en${currentPath}`;
  } else {
    // EN → JA: /en を削除
    return currentPath.replace(/^\/en(\/|$)/, '/') || '/';
  }
};

// og:localeの設定
const ogLocale = isEnglish ? "en_US" : "ja_JP";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LpHeader from "../components/lp/LpHeader.astro";
import LpFooter from "../components/lp/LpFooter.astro";
import "../assets/styles/style.scss";
const scriptHtml = `
  <script src="/assets/js/main.js"></script>
`;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO基本 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://dddynamis.com${Astro.url.pathname}`} />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:url"
      content={`https://dddynamis.com${Astro.url.pathname}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- hreflang -->
    <link rel="alternate" hreflang="ja" href={`https://dddynamis.com${getAlternateLanguageUrl("ja")}`} />
    <link rel="alternate" hreflang="en" href={`https://dddynamis.com${getAlternateLanguageUrl("en")}`} />
    <link rel="alternate" hreflang="x-default" href={`https://dddynamis.com${getAlternateLanguageUrl("ja")}`} />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Critical CSS (CLS/LCP対策) -->
    <style is:inline>
      :root {
        --body-font: system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, "Noto Sans JP", "Hiragino Sans",
          "Yu Gothic UI", "Meiryo", sans-serif;
      }
      :root {
        --hero-h: 100vh;
      }
      @supports (height: 100dvh) {
        :root {
          --hero-h: 100dvh;
        }
      }
      body {
        color: #fff;
        font-family: var(--body-font);
        margin: 0;
      }
      .hero {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: var(--hero-h);
        overflow: hidden;
        z-index: 1;
        background-color: #0F1826;
      }
      .hero .container {
        height: 100%;
        display: flex;
        align-items: center;
        position: relative;
        max-width: 1110px;
        margin: 0 auto;
        padding: 0 15px;
      }
      .hero-ttl {
        min-height: 186px;
        opacity: 0;
        transition: opacity 0.8s ease;
        font-size: 7rem;
        font-weight: bold;
        line-height: 1.32;
        margin: 0;
      }
      .hero-bg {
        position: absolute;
        inset: 0;
      }
      .hero-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .hero-veil {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(15,24,38,.94) 0%, rgba(15,24,38,.72) 46%, rgba(15,24,38,.4) 100%);
      }
      @media (max-width: 768px) {
        .hero-ttl {
          font-size: 2.6rem;
          min-height: 78px;
        }
      }
      .challenges,
      .why,
      .shift,
      .service,
      .plan,
      .profile,
      .flow,
      #contact,
      footer {
        content-visibility: auto;
        contain-intrinsic-size: 1px 1200px;
      }
    </style>
    <!-- Preconnect for Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preconnect for microCMS Images CDN (LCP画像の握手を前倒し) -->
    <link
      rel="preconnect"
      href="https://images.microcms-assets.io"
      crossorigin
    />
    <!-- FV画像のプリロード（LCP対策） -->
    <link rel="preload" as="image" href="/assets/images/photo/hero-factory.webp" media="(min-width:769px)" />
    <link rel="preload" as="image" href="/assets/images/photo/hero-factory-sp.webp" media="(max-width:768px)" />

    <!-- Google Fonts with font-display swap for immediate fallback -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript
      ><link
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@700&display=swap"
        rel="stylesheet"
      /></noscript
    >
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript
      ><link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
        rel="stylesheet"
      /></noscript
    >
  </head>
  <body>
    {lp ? <LpHeader ctaLabel={lpCta?.header} stickyLabel={lpCta?.sticky} /> : <Header />}
    <slot />
    {lp ? <LpFooter /> : <Footer />}
    <div set:html={scriptHtml} />
  </body>
</html>
