---
/*
  相互リンク：合同会社TechnoKuRo（https://techno-kuro.com/）のバナーと紹介文（2026-11-09 本人指示・先方へ提案用の仮置き。push しない）
  使い方：/security と /security/ai-app に置く。
    <PartnerTechnoKuro variant="section" /> … FAQ の前の節（バナー＋紹介文）
    <PartnerTechnoKuro variant="float" />   … 追従CTAの上に小さく出すバナー（表示・非表示は追従CTAに合わせる。×で閉じられる）
  紹介文の事実は先方サイト（トップ・代表紹介）から：ISMS/Pマークの取得・運用、情報セキュリティ顧問、情報処理安全確保支援士、IRCA ISMS准審査員、元警察官。
  スタイルは _corp-security.scss 末尾「相互リンク（TechnoKuRo）」。
*/
const { variant = "section" } = Astro.props;
const URL = "https://techno-kuro.com/";
---
{variant === "section" ? (
  <section class="cp-sec pt-sec" aria-labelledby="pt-ttl">
    <div class="cp-container">
      <header class="cp-head cp-head--center" data-reveal>
        <p class="cp-head__en eng">Partner</p>
        <h2 class="cp-head__ttl" id="pt-ttl">会社の情報セキュリティは、パートナーと一緒に</h2>
        <p class="cp-head__lead">サイトやアプリの点検はDDDynamisが行います。ISMS・Pマークのように、会社としてのルールや運用を整えるご相談は、合同会社TechnoKuRoをご紹介しています。</p>
      </header>
      <a href={URL} class="pt-card" target="_blank" rel="noopener" data-reveal>
        <picture class="pt-card__logo">
          <source srcset="/assets/images/partner/technokuro-logo.webp" type="image/webp" />
          <img src="/assets/images/partner/technokuro-logo.png" alt="TechnoKuRo" width="160" height="160" loading="lazy" decoding="async" />
        </picture>
        <span class="pt-card__body">
          <span class="pt-card__tag">ISMS・Pマーク／情報セキュリティ顧問</span>
          <span class="pt-card__name">合同会社TechnoKuRo</span>
          <span class="pt-card__txt">情報処理安全確保支援士・ISMS准審査員の資格を持つ、元警察官のエンジニアが代表です。審査で説明でき、現場で続けやすい運用づくりを、取得から運用まで支援しています。</span>
          <span class="pt-card__more">TechnoKuRoのサイトを見る</span>
        </span>
      </a>
    </div>
  </section>
) : (
  <aside class="pt-float" id="js-pt-float" aria-label="パートナーのご紹介">
    <a href={URL} class="pt-float__link" target="_blank" rel="noopener">
      <img src="/assets/images/partner/technokuro-logo.png" alt="" width="40" height="40" loading="lazy" decoding="async" />
      <span class="pt-float__txt"><small>ISMS・Pマークのご相談は</small>TechnoKuRo</span>
    </a>
    <button type="button" class="pt-float__close" aria-label="閉じる">×</button>
  </aside>
  <script is:inline>
    // 追従CTA（#js-sticky-cta）と同じときだけ出す。×で閉じたらこのタブの間は出さない
    document.addEventListener("DOMContentLoaded", () => {
      const el = document.getElementById("js-pt-float");
      const cta = document.getElementById("js-sticky-cta");
      if (!el || !cta) return;
      let closed = false;
      try { closed = sessionStorage.getItem("pt-float-closed") === "1"; } catch (e) {}
      const sync = () => el.classList.toggle("is-visible", !closed && cta.classList.contains("is-visible") && !cta.classList.contains("is-hidden-by-form"));
      new MutationObserver(sync).observe(cta, { attributes: true, attributeFilter: ["class"] });
      el.querySelector(".pt-float__close").addEventListener("click", () => {
        closed = true; sync();
        try { sessionStorage.setItem("pt-float-closed", "1"); } catch (e) {}
      });
      sync();
    });
  </script>
)}
