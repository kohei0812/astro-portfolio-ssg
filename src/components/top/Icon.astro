---
//src/components/top/Icon.astro
/*
  セクションで使う線画アイコン。
  24x24 / fill なし / stroke は currentColor / 線幅1.5 で統一しているので、
  置いた場所の color をそのまま継ぐ。装飾は足さないこと。

  使う側の例:
    <Icon name="interview" />
*/
const { name } = Astro.props;

const paths: Record<string, string> = {
  // --- Service（支援の6ステップ） ---
  teach: `<rect x="2.5" y="4" width="19" height="12.5" rx="1.5"/>
          <path d="M12 16.5v4"/><path d="M8 20.5h8"/>
          <path d="M6.5 8h7"/><path d="M6.5 11.5h4.5"/>`,
  interview: `<rect x="2" y="4" width="12" height="9" rx="2"/>
              <path d="M6 13v3.2L9.2 13"/>
              <rect x="10" y="10.5" width="12" height="9" rx="2"/>
              <path d="M18 19.5v3.2L14.8 19.5"/>`,
  redesign: `<rect x="2" y="3" width="7" height="5" rx="1"/>
             <rect x="15" y="3" width="7" height="5" rx="1"/>
             <rect x="8.5" y="16" width="7" height="5" rx="1"/>
             <path d="M5.5 8v3.5h13V8"/><path d="M12 11.5V16"/>`,
  automate: `<circle cx="12" cy="12" r="7.4"/><circle cx="12" cy="12" r="2.6"/>
             <path d="M12 4.6V2.6M12 21.4v-2M4.6 12H2.6M21.4 12h-2"/>
             <path d="M6.75 6.75L5.3 5.3M18.7 18.7l-1.45-1.45M17.25 6.75L18.7 5.3M5.3 18.7l1.45-1.45"/>`,
  train: `<circle cx="7.5" cy="7.5" r="3"/>
          <path d="M2 20v-1a5.5 5.5 0 0 1 11 0v1"/>
          <path d="M15.5 12.5l3-3 3 3"/><path d="M18.5 9.5V20"/>`,
  operate: `<path d="M20.5 12a8.5 8.5 0 1 1-2.5-6"/>
            <path d="M20.5 2.5v4h-4"/>`,

  // --- First Session（初回2時間） ---
  chat: `<rect x="2" y="4" width="20" height="13.5" rx="2"/>
         <path d="M8 17.5v3.5l4.5-3.5"/>
         <path d="M6.5 9h11"/><path d="M6.5 12.5h6.5"/>`,
  setup: `<rect x="3" y="4.5" width="18" height="11.5" rx="1.5"/>
          <path d="M1.5 19.5h21"/>
          <circle cx="12" cy="10.2" r="2.3"/>
          <path d="M12 6.2v1.7M12 12.5v1.7M8 10.2h1.7M14.3 10.2H16"/>`,
  inventory: `<rect x="4" y="2.5" width="16" height="19" rx="2"/>
              <path d="M7.5 8l1.6 1.6L12 6.8"/>
              <path d="M7.5 15l1.6 1.6L12 13.8"/>
              <path d="M13.8 8.4h3.2"/><path d="M13.8 15.4h3.2"/>`,
  workflow: `<circle cx="5" cy="6" r="2.2"/><circle cx="5" cy="18" r="2.2"/>
             <circle cx="19" cy="12" r="2.2"/>
             <path d="M7.2 6h5.3a2 2 0 0 1 2 2v1.9"/>
             <path d="M7.2 18h5.3a2 2 0 0 0 2-2v-1.9"/>`,
  propose: `<path d="M9.2 18.5h5.6"/><path d="M10.2 21.3h3.6"/>
            <path d="M12 2.7a6.2 6.2 0 0 0-3.6 11.2c.6.5.9 1.2.9 1.9v.2h5.4v-.2c0-.7.3-1.4.9-1.9A6.2 6.2 0 0 0 12 2.7z"/>`,
  roadmap: `<path d="M6 21.5V3"/>
            <path d="M6 3.5h11.5l-2.6 3.6 2.6 3.6H6"/>`,
};

const d = paths[name] ?? "";
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>
