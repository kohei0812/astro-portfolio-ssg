---
//src/components/top/Strength.astro
const isEnglish = Astro.url.pathname.startsWith("/en");

const rows = isEnglish
  ? [
      { area: "Introduction", mine: "I interview the work, then introduce AI in the form that pays off fastest.", theirs: "Teaches how to use AI" },
      { area: "Process", mine: "I take stock of the work and rebuild the flow around AI.", theirs: "Teaches how to write prompts" },
      { area: "Training", mine: "Hands-on training on your real work, until staff run it alone.", theirs: "Runs seminars and courses" },
      { area: "Operation", mine: "Chat and regular reviews, until it settles into the floor.", theirs: "After the course, you're on your own" },
      { area: "Development", mine: "If it needs an app or a system, I build it myself.", theirs: "Cannot build software" },
    ]
  : [
      { area: "導入", mine: "課題と業務をヒアリングし、成果が出る形で導入する", theirs: "AIの使い方を教える" },
      { area: "業務改善", mine: "業務を棚卸しし、AIを前提にフローから作り直す", theirs: "プロンプトの書き方を教える" },
      { area: "教育", mine: "自社の実務を教材に、社員が自分で使えるまで訓練する", theirs: "セミナー・研修を行う" },
      { area: "運用", mine: "チャットと定期面談で、現場に定着するまで伴走する", theirs: "研修後は各自での運用" },
      { area: "開発", mine: "必要なら業務アプリやシステムまで自分で開発する", theirs: "開発は対応不可" },
    ];
---

<section
  class="ai-sec ai-sec--dark strength"
  id="strength"
  aria-labelledby="strength-heading"
>
  <div class="container">
    <header class="ai-head">
      <p class="ai-head__eyebrow eng">Strength</p>
      <h2 class="ai-head__ttl" id="strength-heading">
        {isEnglish ? "Where this differs from a typical AI instructor" : "一般的なAI講師との違い"}
      </h2>
      <p class="ai-head__lead">
        {isEnglish
          ? "Teaching is where most support ends. For me it is where the work starts."
          : "多くの支援は「教える」で終わります。私はそこからが本番です。"}
      </p>
    </header>

    <div class="strength-table fadeInTrigger">
      <div class="strength-table__head" aria-hidden="true">
        <span class="strength-table__area"></span>
        <span class="strength-table__mine">{isEnglish ? "This service" : "私"}</span>
        <span class="strength-table__theirs">{isEnglish ? "A typical AI instructor" : "一般的なAI講師"}</span>
      </div>

      {rows.map((row) => (
        <div class="strength-table__row">
          <div class="strength-table__area">
            <span class="strength-table__area-name">{row.area}</span>
          </div>
          <div class="strength-table__mine">{row.mine}</div>
          <div class="strength-table__theirs">{row.theirs}</div>
        </div>
      ))}
    </div>

    <p class="ai-note">
      {isEnglish ? (
        <>
          <span class="ai-marker">I don't stop at teaching.</span> I stay until the work changes and your staff run it alone.
        </>
      ) : (
        <>
          <span class="ai-marker">「教えて終わり」にしません。</span>業務が変わり、社員が自走するまで。
        </>
      )}
    </p>
  </div>
</section>
