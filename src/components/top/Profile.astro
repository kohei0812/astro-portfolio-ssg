---
//src/components/top/Profile.astro
const isEnglish = Astro.url.pathname.startsWith('/en');

/* 経歴は時系列そのものが中身なので、順番の分かる形で出す */
const career = isEnglish
  ? [
      { name: "Law degree at Kobe University, then a SIer", txt: "Started working life in sales" },
      { name: "Left, questioning the track I was on", txt: "Chose my own way over a stable one" },
      { name: "Band, bartending, gardening", txt: "Years of work on the floor, face to face with people" },
      { name: "At 37, decided to become a web engineer", txt: "Went to the Philippines to study English and IT" },
      { name: "Freelance web engineer, then AI consulting", txt: "Back home, started AI support alongside development work" },
    ]
  : [
      { name: "神戸大学法学部を卒業、新卒でSIerへ", txt: "営業職として社会人をスタート" },
      { name: "レールに乗った人生に疑問を感じ、退職", txt: "安定より、自分で選ぶ生き方へ" },
      { name: "バンド活動 × バーテンダー × 植木職人", txt: "現場の仕事で、人と向き合い続けた時代" },
      { name: "37歳、Webエンジニアになると決意", txt: "フィリピンへ英語×ITの留学" },
      { name: "フリーランスWebエンジニア → AIコンサルへ", txt: "帰国後、開発の実務と並行してAI活用支援を開始" },
    ];
---

<section class="profile" id="profile" aria-labelledby="profile-heading">
  <picture class="profile-bg">
    <source media="(min-width: 769px)" srcset="/assets/images/profile-bg.webp" type="image/webp" />
    <source media="(min-width: 769px)" srcset="/assets/images/profile-bg.jpg" />
    <source srcset="/assets/images/profile-bgSP.webp" type="image/webp" />
    <img
      src="/assets/images/profile-bgSP.jpg"
      alt={isEnglish ? "Background image" : "背景画像"}
      width="1000"
      height="800"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="container">
    {/*
      顔写真は現状モノクロの暗いスナップで、この文脈に合わないため使っていない。
      ビジネス用の写真が用意できたら profile-photo として左に戻す。
    */}
    <div class="profile-main">
      <div class="profile-head">
        <p class="ai-head__eyebrow eng">Profile</p>
        <h2 class="profile-name" id="profile-heading">
          {isEnglish ? (
            <>Kohei Kawabata<span class="profile-name__en">川端 康平</span></>
          ) : (
            <>川端 康平<span class="profile-name__en eng">Kohei Kawabata</span></>
          )}
        </h2>
        <p class="profile-role">
          {isEnglish
            ? "AI adoption consultant × Web engineer"
            : "AI活用支援コンサルタント × Webエンジニア"}
        </p>
      </div>

      {/* 年表の「バンド活動」に対応する当時の写真。他の写真と同じデュオトーンで色を揃えている */}
      <div class="profile-photo">
        <picture>
          <source media="(min-width: 769px)" srcset="/assets/images/photo/profile-live.webp" type="image/webp" />
          <source media="(min-width: 769px)" srcset="/assets/images/photo/profile-live.jpg" />
          <source srcset="/assets/images/photo/profile-live-sp.webp" type="image/webp" />
          <img
            src="/assets/images/photo/profile-live-sp.jpg"
            alt={isEnglish ? "Kohei Kawabata playing guitar on stage" : "ステージでギターを弾く川端康平"}
            width="1200" height="800" loading="lazy" decoding="async"
          />
        </picture>
      </div>
    </div>

    {/* 経歴は横一本の年表にして、縦積みが続く他セクションと流れを変える */}
    <ol class="profile-career fadeInTrigger">
      {career.map((step) => (
        <li class="profile-career__item">
          <h3 class="profile-career__name">{step.name}</h3>
          <p class="profile-career__txt">{step.txt}</p>
        </li>
      ))}
    </ol>

    <p class="profile-catch">
      {isEnglish ? (
        <>I left a burning development floor after a year, and came back the long way round.<br /><span class="ai-marker">DX never reached small businesses. AI is how it gets there.</span></>
      ) : (
        <>炎上する開発現場を1年で離れ、遠回りしてここに戻りました。<br /><span class="ai-marker">中小企業に届かなかったDXを、AIで届けます。</span></>
      )}
    </p>
  </div>
</section>
