---
//src/components/top/Flow.astro
// 依頼の流れ＋クロージングのCTAを1つにまとめたもの。.cta は _common.scss の共通パーツ。
const isEnglish = Astro.url.pathname.startsWith("/en");

const steps = isEnglish
  ? [
      { name: "Get in touch", txt: "Email or LINE." },
      { name: "Talk it through", txt: "Your work, your problems. Free." },
      { name: "Proposal and quote", txt: "Scope and price, in writing." },
      { name: "Start", txt: "Two hours, and something runs." },
    ]
  : [
      { name: "お問い合わせ", txt: "メール・LINEから" },
      { name: "初回ヒアリング", txt: "業務とお悩みを伺います。無料です" },
      { name: "ご提案・お見積り", txt: "支援内容と費用をご提示" },
      { name: "支援スタート", txt: "初回2時間で、ひとつ動かす" },
    ];
---

<section class="ai-sec flow" id="flow" aria-labelledby="flow-heading">
  <div class="container">
    <header class="ai-head">
      <p class="ai-head__eyebrow eng">Flow</p>
      <h2 class="ai-head__ttl" id="flow-heading">
        {isEnglish ? "Getting started" : "ご依頼の流れ"}
      </h2>
    </header>

    <ol class="flow-steps fadeInTrigger">
      {steps.map((step, i) => (
        <li class="flow-steps__item">
          <p class="ai-num"><span>{String(i + 1).padStart(2, "0")}</span></p>
          <picture class="flow-steps__illust">
            <source srcset={`/assets/images/illust/flw-0${i + 1}.webp`} type="image/webp" />
            <img src={`/assets/images/illust/flw-0${i + 1}.png`} alt="" loading="lazy" decoding="async" />
          </picture>
          <h3 class="flow-steps__name">{step.name}</h3>
          <p class="flow-steps__txt">{step.txt}</p>
        </li>
      ))}
    </ol>

    <div class="flow-cta cta">
      <p class="cta-p">
        {isEnglish ? (
          <>"I don't know what to ask for yet"<br />is a fine place to start.</>
        ) : (
          <>「何を頼めばいいか分からない」<br class="sp_only" />という段階で構いません。</>
        )}
      </p>
      <a href="#contact" class="cta-link">
        {isEnglish ? "Book a free consultation" : "無料で相談する"}
      </a>
    </div>
  </div>
</section>
