---
//src/components/top/Reframe.astro
const isEnglish = Astro.url.pathname.startsWith("/en");

const tasks = isEnglish
  ? [
      { name: "Documents", detail: "Proposals, reports, plans" },
      { name: "Data processing", detail: "Aggregation, visualization, reporting" },
      { name: "System development", detail: "Apps, tools, automation" },
      { name: "Everything else", detail: "Email drafts, summaries, organizing" },
    ]
  : [
      { name: "資料作成", detail: "提案書・報告書・企画書など" },
      { name: "データ処理・分析", detail: "集計・可視化・レポート化" },
      { name: "システム開発", detail: "アプリ・ツール・自動化" },
      { name: "その他の業務", detail: "メール作成・要約・整理など" },
    ];
---

<section class="ai-sec reframe" id="reframe" aria-labelledby="reframe-heading">
  <div class="container">
    <header class="ai-head">
      <p class="ai-head__eyebrow eng">Reframe</p>
      <h2 class="ai-head__ttl" id="reframe-heading">
        {isEnglish ? "AI is no longer just someone to ask" : "AIはもう「相談相手」ではない"}
      </h2>
      <p class="ai-head__lead">
        {isEnglish
          ? "Give it one instruction and it delivers documents, data work, even software."
          : <>指示を出すだけで、資料作成からシステム開発まで<br class="sp_only" />こなす「実行者」になっています。</>}
      </p>
    </header>

    <div class="reframe-compare fadeInTrigger">
      <div class="reframe-compare__col is-before">
        <p class="ai-label ai-label--muted">
          <span>{isEnglish ? "The common image" : "一般的なイメージ"}</span>
        </p>
        <p class="reframe-compare__lead">
          {isEnglish ? (
            <>AI is <span class="reframe-em">only someone to consult</span></>
          ) : (
            <>AIは、<span class="reframe-em">相談相手</span>でしかない</>
          )}
        </p>
        <picture class="reframe-compare__illust">
          <source srcset="/assets/images/illust/reframe-before.webp" type="image/webp" />
          <img src="/assets/images/illust/reframe-before.png" alt="" loading="lazy" decoding="async" />
        </picture>
        <ul class="reframe-balloons">
          <li>{isEnglish ? "What do you think about this?" : "これってどう思う？"}</li>
          <li>{isEnglish ? "Here's one way to look at it…" : "こう考えられますよ。例えば…"}</li>
        </ul>
      </div>

      <div class="reframe-compare__col is-after">
        <p class="ai-label">
          <span>{isEnglish ? "In reality" : "実際は"}</span>
        </p>
        <p class="reframe-compare__lead">
          {isEnglish ? (
            <>AI is <span class="reframe-em">a partner that does the work</span></>
          ) : (
            <>AIは、<span class="reframe-em">仕事をしてもらえる</span>パートナー</>
          )}
        </p>
        <picture class="reframe-compare__illust">
          <source srcset="/assets/images/illust/reframe-after.webp" type="image/webp" />
          <img src="/assets/images/illust/reframe-after.png" alt="" loading="lazy" decoding="async" />
        </picture>
        <ul class="reframe-tasks">
          {tasks.map((task) => (
            <li class="reframe-tasks__item">
              <span class="reframe-tasks__name">{task.name}</span>
              <span class="reframe-tasks__detail">{task.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="ai-note">
      {isEnglish ? (
        <>The premise has shifted: from <span class="ai-marker">using AI</span> to <span class="ai-marker">having AI work for you</span>.</>
      ) : (
        <>「AIを使う」から<span class="ai-marker">「AIに働いてもらう」</span>へ、前提が変わっています。</>
      )}
    </p>
  </div>
</section>
