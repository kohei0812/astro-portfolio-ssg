---
//src/components/top/hero/Hero.astro
import HeroTextSwiper from "./HeroTextSwiper.jsx";
const isEnglish = Astro.url.pathname.startsWith('/en');
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  {/*
    背景はサイトの紺にデュオトーン処理した現場写真。
    素材は Unsplash（商用利用可・クレジット不要）。
    色を落としてあるのは、主役をタイポグラフィのままにするため。
  */}
  <picture class="hero-bg">
    <source media="(min-width: 769px)" srcset="/assets/images/photo/hero-factory.webp" type="image/webp" />
    <source media="(min-width: 769px)" srcset="/assets/images/photo/hero-factory.jpg" />
    <source srcset="/assets/images/photo/hero-factory-sp.webp" type="image/webp" />
    <img
      src="/assets/images/photo/hero-factory-sp.jpg"
      alt=""
      width="2000"
      height="1125"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-copy">
      <p class="hero-eyebrow eng fadeInTrigger">AI Transformation</p>
      {/*
        キャッチは ChatGPT に10案出させたうちの一つ。
        「これまでのやり方では大企業しかDXが進まなかった」という
        事業の出発点（BNI資料）と直結するものを選んでいる。
        別案: 「業務を変える力を、自社の中に。」/「中小企業の業務変革を、AIで現実に。」
      */}
      <h1 class="hero-ttl fadeInTrigger" id="hero-ttl">
        {isEnglish ? (
          <>
            Change shouldn't belong<br />
            to big companies alone.
          </>
        ) : (
          <>
            業務変革を、<br />
            大企業だけのものにしない。
          </>
        )}
      </h1>
      <p class="hero-service fadeInTrigger">
        {isEnglish ? "AI adoption support for small businesses" : "中小企業のAI活用支援"}
      </p>
      <p class="hero-sub fadeInTrigger">
        {isEnglish ? (
          <>Not "how to use AI" — I rebuild how the work runs, until your own staff can change it themselves.</>
        ) : (
          <>AIの使い方を教えるのではなく、<br class="sp_only" />業務そのものを作り替える。<br />
          最後は、社員が自分の手で変えられる状態にします。</>
        )}
      </p>
    </div>
  </div>
  <HeroTextSwiper lang={isEnglish ? "en" : "ja"} client:load />
</section>
