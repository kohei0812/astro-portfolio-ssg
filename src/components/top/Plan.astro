---
//src/components/top/Plan.astro
const isEnglish = Astro.url.pathname.startsWith('/en');

/*
  タブは「人数」で切り替わる。自社に当てはまる型だけを見れば済むので、
  切り替え自体が情報になっている。タブの挙動は public/assets/js/main.js。
*/
const consultIncludes = isEnglish
  ? [
      "Interview on your work and where AI fits",
      "Workflow design and an automation plan",
      "Hands-on training on your own real tasks",
      "A roadmap you can act on the next day",
    ]
  : [
      "業務ヒアリングとAI活用ポイントの整理",
      "ワークフロー設計・自動化の提案",
      "自社の実務そのものを教材にした実践トレーニング",
      "翌日から動けるロードマップのお渡し",
    ];

const seminarIncludes = isEnglish
  ? [
      "AI basics for ChatGPT and Claude",
      "Account and PC setup, done on the spot",
      "Exercises on the work your team actually does",
      "A shared starting point across the team",
    ]
  : [
      "ChatGPT・ClaudeのAI基本講習",
      "アカウント・PC環境の初期設定をその場で完了",
      "自社の業務に沿った演習",
      "全員の目線を揃えたスタート",
    ];
---
<section class="plan" id="plan" aria-labelledby="plan-heading">
  <div class="plan-bg"></div>
  <div class="container">
    <h2 class="plan-ttl section-ttl eng" id="plan-heading">plan</h2>
    <p class="plan-lead">
      {isEnglish
        ? <>Two formats, chosen by <span class="ai-strong">how many people join</span>.</>
        : <>人数に合わせて、<span class="ai-strong">2つの型</span>をご用意しています。</>}
    </p>
    <div class="plan-tab">
      <div class="plan-tab__item left active">
        <p>{isEnglish ? 'Up to 5 people' : '〜5人の場合'}</p>
      </div>
      <div class="plan-tab__item right">
        <p>{isEnglish ? '6 people or more' : '6人以上の場合'}</p>
      </div>
    </div>
    <div class="plan-main">
      <!-- 〜5人：コンサルティング型 -->
      <div class="plan-panel plan-main__item active">
        <picture class="plan-panel__illust">
          <source srcset="/assets/images/illust/plan-consult.webp" type="image/webp" />
          <img src="/assets/images/illust/plan-consult.png" alt="" loading="lazy" decoding="async" />
        </picture>
        <h3 class="plan-panel__name">{isEnglish ? 'Consulting format' : 'コンサルティング型'}</h3>
        <p class="plan-panel__for">
          {isEnglish
            ? 'For a small team that wants to change the work itself'
            : '業務そのものを変えたい少人数のチーム向け'}
        </p>
        <p class="plan-panel__fee">
          <span class="plan-panel__price eng">15,000</span>
          <span class="plan-panel__unit">{isEnglish ? 'yen / hour' : '円／1時間'}</span>
        </p>
        <p class="plan-panel__cond">{isEnglish ? 'From 2 hours per request' : '最低2時間からのご依頼'}</p>
        <ul class="plan-panel__list">
          {consultIncludes.map((item) => (
            <li class="plan-panel__list-item">{item}</li>
          ))}
        </ul>
        <p class="plan-panel__bonus">
          {isEnglish ? (
            <>On a six-month retainer with one visit a month, <span class="plan-panel__bonus-em">LINE chat support is included at no charge</span>.</>
          ) : (
            <>月1回訪問 × 半年の顧問契約なら、<span class="plan-panel__bonus-em">無料LINEチャットサポート付き</span></>
          )}
        </p>
      </div>

      <!-- 6人以上：セミナー型 -->
      <div class="plan-panel plan-main__item">
        <picture class="plan-panel__illust">
          <source srcset="/assets/images/illust/plan-seminar.webp" type="image/webp" />
          <img src="/assets/images/illust/plan-seminar.png" alt="" loading="lazy" decoding="async" />
        </picture>
        <h3 class="plan-panel__name">{isEnglish ? 'Seminar format' : 'セミナー型'}</h3>
        <p class="plan-panel__for">
          {isEnglish
            ? 'For getting a whole department started at once'
            : '部署単位で一斉にスタートしたい場合向け'}
        </p>
        <p class="plan-panel__fee">
          <span class="plan-panel__price eng">15,000</span>
          <span class="plan-panel__unit">{isEnglish ? 'yen / person' : '円／1人'}</span>
        </p>
        <p class="plan-panel__cond">{isEnglish ? 'A 2-hour session' : '2時間の講習'}</p>
        <ul class="plan-panel__list">
          {seminarIncludes.map((item) => (
            <li class="plan-panel__list-item">{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="plan-notes">
      <li class="plan-notes__item">
        {isEnglish
          ? 'On-site visits add a 5,000 yen travel fee per visit.'
          : 'オフライン（訪問）の場合は出張費 5,000円／回'}
      </li>
      <li class="plan-notes__item">
        {isEnglish
          ? 'Full system development is quoted separately, based on the requirements.'
          : '本格的なシステム開発など、要件によっては別途お見積り'}
      </li>
    </ul>
  </div>
</section>
