---
//src/components/top/FirstSession.astro
const isEnglish = Astro.url.pathname.startsWith("/en");

const items = isEnglish
  ? [
      { name: "AI basics, hands on", txt: "ChatGPT and Claude, and where they help at work." },
      { name: "Setup, on the spot", txt: "Accounts and PC ready before you leave." },
      { name: "Mapping the work", txt: "Pin down what AI can take over." },
      { name: "Workflow design", txt: "Decide which part of which task AI handles." },
      { name: "Automation plan", txt: "Start from the work with the biggest payoff." },
      { name: "What comes next", txt: "A roadmap you can act on tomorrow." },
    ]
  : [
      { name: "AI基本操作説明", txt: "ChatGPT・Claudeの基本と、業務で使う勘所" },
      { name: "初期設定", txt: "アカウント・PC環境をその場で構築" },
      { name: "業務整理", txt: "AIに任せられる仕事を洗い出す" },
      { name: "ワークフロー設計", txt: "どの業務のどの部分を任せるかを設計" },
      { name: "自動化提案", txt: "効果の大きい業務から道筋を提示" },
      { name: "次にやること", txt: "明日から動けるロードマップをお渡し" },
    ];
---

<section
  class="ai-sec ai-sec--dark firstsession"
  id="firstsession"
  aria-labelledby="firstsession-heading"
>
  <div class="container">
    <header class="ai-head">
      <p class="ai-head__eyebrow eng">First Session</p>
      <h2 class="ai-head__ttl" id="firstsession-heading">
        {isEnglish ? "What the first two hours cover" : "初回2時間でやること"}
      </h2>
      <p class="ai-head__lead">
        {isEnglish
          ? "From the basics of ChatGPT and Claude through to your own tasks, in one sitting."
          : "ChatGPT・Claudeの基本から、自社の業務への落とし込みまでを一度に進めます。"}
      </p>
    </header>

    <ul class="firstsession-list fadeInTrigger">
      {items.map((item, i) => (
        <li class="firstsession-list__item ai-card">
          <p class="ai-num"><span>{String(i + 1).padStart(2, "0")}</span></p>
          <picture class="firstsession-list__illust">
            <source srcset={`/assets/images/illust/first-0${i + 1}.webp`} type="image/webp" />
            <img
              src={`/assets/images/illust/first-0${i + 1}.png`}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </picture>
          <h3 class="ai-card__ttl">{item.name}</h3>
          <p class="ai-card__txt">{item.txt}</p>
        </li>
      ))}
    </ul>

    <p class="ai-note">
      {isEnglish ? (
        <>This is not a sit-and-listen course. <span class="ai-marker">Two hours in, your own work is already running.</span></>
      ) : (
        <>聞いて終わりの研修ではありません。2時間後には、<span class="ai-marker">自社の業務が実際に動き始めます。</span></>
      )}
    </p>
  </div>
</section>
