---
//src/components/top/Challenges.astro
const isEnglish = Astro.url.pathname.startsWith('/en');

const challenges = isEnglish
  ? [
      "We don't have enough people",
      "The work lives in one person's head",
      "Too busy to fix how we work",
      "Too small to hire a system company",
      "We want to use AI, but don't know where to start",
    ]
  : [
      "人手が足りない",
      "業務が属人化している",
      "忙しすぎて改善する余裕がない",
      "システム会社に頼むほどの規模ではない",
      "AIを使いたいが、何から始めればいいかわからない",
    ];
---

<section
  class="challenges"
  id="challenges"
  aria-labelledby="challenges-heading"
>
  <picture class="challenges-bg">
    <source
      media="(min-width: 769px)"
      srcset="/assets/images/challenges-bg.webp"
      type="image/webp"
    />
    <source
      media="(min-width: 769px)"
      srcset="/assets/images/challenges-bg.jpg"
    />
    <source srcset="/assets/images/challenges-bgSP.webp" type="image/webp" />
    <img
      src="/assets/images/challenges-bgSP.jpg"
      alt={isEnglish ? "Background image" : "背景画像"}
      width="1000"
      height="2000"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <h2 class="challenges-ttl eng" id="challenges-heading">Your Challenges</h2>
  <div class="container">
    <p class="challenges-sub">
      {isEnglish ? "Does any of this sound familiar?" : "こんなお悩みはありませんか？"}
    </p>
    <ul class="challenges-list">
      {challenges.map((challenge) => (
        <li class="challenges-list__item">
          <p>{isEnglish ? `“${challenge}”` : `「${challenge}」`}</p>
        </li>
      ))}
    </ul>
    <p class="challenges-catch">
      {isEnglish
        ? <>If even one of them fits,<br />I can help.</>
        : <>どれか1つでも<br />当てはまれば、<br class="sp_only" />お力になれます。</>
      }
    </p>
    <div class="challenges-cta cta">
      <p class="cta-p">{isEnglish ? "The first consultation is free" : "初回相談は無料です"}</p>
      <a href="#contact" class="cta-link">{isEnglish ? "Book a free consultation" : "無料で相談してみる"}</a>
    </div>
  </div>
</section>
