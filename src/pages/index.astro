---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/top/hero/Hero.astro";
import Challenges from "../components/top/Challenges.astro";
import Shift from "../components/top/Shift.astro";
import Service from "../components/top/Service.astro";
import PhotoBand from "../components/top/PhotoBand.astro";
import Profile from "../components/top/Profile.astro";
import Plan from "../components/top/Plan.astro";
import Flow from "../components/top/Flow.astro";
import ContactForm from "../components/ContactForm.jsx";
---

<Layout
  title="中小企業のAX支援 | 川端康平"
  description="AIの使い方を教えるのではなく、業務そのものを作り替える。初回2時間で御社の業務をひとつ自動化し、最後は社員が自分の手で変えられる状態にします。初回相談は無料。"
>
  <!-- 構造化データ（JSON-LD） -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "Dynamis",
      url: "https://dddynamis.com/",
      description:
        "中小企業向けのAX（AI変革）支援。業務の再設計から自動化、社員が自走するまでの伴走まで。",
      areaServed: "JP",
      founder: {
        "@type": "Person",
        name: "川端 康平",
        jobTitle: "AI活用支援コンサルタント / Webエンジニア",
      },
    })}
  />
  <!-- main -->
  <main id="top" role="main">
    <Hero />
    <Challenges />
    <Shift />
    <Service />
    <PhotoBand />
    <Profile />
    <Plan />
    <Flow />
    <ContactForm lang="ja" client:visible />
  </main>
</Layout>
