    "trust": [
      {
        "name": "データの中身を見られない構成",
        "txt": "保存データを暗号化し、お客様が鍵を管理することで、当方が中身を閲覧できない構成を設計します。"
      },
      {
        "name": "お客様の環境で作業",
        "txt": "守秘義務契約を結んだうえで訪問し（リモートでも対応可）、お客様のPC・アカウントの中だけで作業します。当方の手元にデータを残しません。"
      },
      {
        "name": "作業記録と引き継ぎ",
        "txt": "誰が、いつ、何をしたかを共有し、お客様の持ち物であるアプリを他の担当者へ引き継げるよう、構成と運用手順を整理します。"
      }
    ]
  },
  "next": {
    "h2": "公開してつなぐから、閉じてつなぐへ",
    "lead": "使う人が決まっている業務アプリまで、全世界に入口を開く必要はありません。これからは、つなぐ相手とデータを置く場所を選ぶ考え方が大切になります。",
    "before": [
      "全世界から開ける場所に置き、ログインだけで守ります。",
      "データをクラウドに集めて置きます。"
    ],
    "after": [
      "利用を認めた人だけが通れる入口でつなぎます。",
      "手元で動くAIを使い、データを外に出さずに処理する方法を選びます。",
      "データを分けて置き、通信が途切れても業務を続けられる形を考えます。"
    ],
    "line": "つながりを守るために、閉じるという選択です。"
  },
  "network": {
    "h2": "Dynamisネットワーク：サイバー戦争時代のシェルター",
    "lead": "アプリをインターネットに公開せずに使うための置き場所です。入口や利用者の管理から日々の運用まで、契約で決めた範囲をDDDynamisが担います。",
    "items": [
      {
        "name": "入口をなくす",
        "txt": "インターネット上の誰もがアクセスできる場所には、アプリの入口を置きません。"
      },
      {
        "name": "やられにくくする",
        "txt": "利用を認めた人だけが、一人ずつログインして入る仕組みにします。"
      },
      {
        "name": "被害を小さくする",
        "txt": "利用者ごとに触れられる情報や操作を絞り、侵入されても被害が広がりにくい構成を設計します。"
      }
    ],
    "note": "料金は月額で、個別にお見積りします。ログインして使う人が決まっているアプリに向いています。非公開でも利用開始前のチェックは必要で、漏えいしないことは約束しません。"
  },
  "steps": {
    "h2": "ご相談から運用までの進め方",
    "lead": "作業はすべて訪問して（リモートでも対応可）、お客様の環境の中で行います。当方の手元にデータを持ち帰ることはありません。",
    "items": [
      {
        "name": "初回相談",
        "txt": "無料で、アプリの用途と気になる点を伺います。"
      },
      {
        "name": "アプリの共有",
        "txt": "訪問して（リモートでも対応可）、相談して決めた範囲をお客様のPCで一緒に確認します。"
      },
      {
        "name": "結果の報告",
        "txt": "確認結果を、直す優先順位とともにお伝えします。"
      },
      {
        "name": "修正",
        "txt": "自社で直すか、当方に任せるかを選べます。任せる場合も、お客様の環境の中で作業します。"
      },
      {
        "name": "公開",
        "txt": "修正後の状態を確認し、公開へ進みます。"
      },
      {
        "name": "運用",
        "txt": "公開後も、必要な範囲の運用をご依頼いただけます。"
      }
    ]
  },
  "faq": {
    "h2": "よくあるご質問",
    "lead": "費用や情報の共有など、ご相談前に気になる点をまとめました。",
