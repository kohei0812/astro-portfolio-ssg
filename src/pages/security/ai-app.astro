---
/*
  AIで作ったアプリの公開・保守（/security/ai-app）。2026-11-03 /security から分離。
  2026-11-03 作り直し（本人指示）：勉強会資料「インターネットの今」v4（AI活用支援/勉強会_インターネットの今_202611/インターネットの今_勉強会_v4.pptx の2〜9枚目、同業向け）の論理を、
  クライアント向けに組み直した。用語のかっこ書きは入れない（本人指示）。自社の構成は資料5枚目の「やりがち→こうする」で短く。
  文言は Codex（scratchpad/codex_aiapp/copy.json）を手直し。FV・図はChatGPT（白・青・金、文字なし。原本 GD/営業/サイト素材/LP_ChatGPT_20261103/）。
  FV は日本の企業LPの型：横幅いっぱいのメインビジュアルに見出しとCTAを重ねる（LP研究_日本LPの力学_20261103 §2・§7）。
  スタイルは _corp-security.scss の .aa-*。
*/
import Layout from "../../layouts/Layout.astro";
import LineIcon from "../../components/corp/LineIcon.astro";
import ConsultForm from "../../components/consultation/ConsultForm.jsx";

const C = {
