---
/*
  サービス（2026-10-02 新設）。料金は載せない（本人判断。「初回相談は無料」だけ書く）。
  中身は 営業/サービス棚卸し_20261002.md、文言は Codex 案（scratchpad/codex/service_copy.md）を元に調整。
  載せないもの：外部講師・講師陣向け研修（BtoB）、1to1コーチング・セキュリティ講座・FDE講座（企画中）、スポット顧問。
  スタイルは _corp-service.scss（共通部品は _corp.scss）。
*/
import Layout from "../layouts/Layout.astro";
import LineIcon from "../components/corp/LineIcon.astro";

/* コース（2026-10-05 本人決定）：事業規模ではなく「誰の仕事を変えるか」で分ける。料金は載せない */
const courses = [
  {
    id: "ikki",
    en: "Ikki-tousen course",
    name: "一騎当千コース",
    catch: "AI秘書を持ち、1人で千人分の仕事を。",
    txt: "社長や個人事業主など、ご自身の仕事を変えるコースです。AIに資料を読ませ、作業を自動で回し、最後は方針に沿って毎朝AIのほうから今日の仕事を知らせてくる秘書をつくります。",
    rows: [
      ["変える仕事", "あなた自身の仕事"],
      ["中身", "セミナー（初級・中級・上級）"],
      ["進め方", "セミナー／伴走（個別・少人数グループ）／構築代行"],
      ["ゴール", "AI秘書が、自分から報告に来る"],
    ],
    href: "#ikki-course",
  },
  {
    id: "gunshi",
    en: "AI Gunshi course",
    name: "AI軍師コース",
    catch: "社員がAIで自走する組織をつくる。",
    txt: "社員が業務でAIを使い、社内で広げ続ける組織をつくるコースです。会社共通のAIと使い続ける仕組みを整え、社内の展開役を育てます。成果指標は研修後のAI利用率です。",
    rows: [
      ["変える仕事", "社員・部署の仕事"],
      ["中身", "9回パッケージ・会社共通のAIづくり"],
      ["進め方", "AI軍師顧問（〜5名）／法人AI研修・9回パッケージ（6名〜）"],
      ["ゴール", "社内の展開役を中心に、AI活用を続けられる"],
    ],
    href: "#org",
  },
];

/* 進め方：コースごとに、人数や関わり方に合わせて柔軟に選ぶ。料金は載せない */
const ikkiWays = [
  { name: "セミナー", tag: "1対多", txt: "初級・中級・上級（各2時間）。前半で説明と手を動かすワーク、後半で質疑応答と活用の発表を行います。", fit: "自分で手を動かして作りたい" },
  { name: "伴走", tag: "個別・少人数グループ", txt: "あなたの環境で、一緒にAI秘書を組みます。時間単位で、必要な分だけ。", fit: "自分の業務で、確実に動く形まで進めたい" },
  { name: "構築代行", tag: "おまかせ", txt: "こちらでAI秘書を組みます。あなたは方針を決めて、判断を返すだけです。", fit: "手を動かす時間を取れない" },
];

const gunshiWays = [
  { name: "AI軍師顧問", tag: "〜5名", txt: "決まった一式を前提にせず、時間単位で必要な分だけ。業務の相談に応じながらその場で自動化を組み、社内の展開役を育てます。", fit: "少人数で、業務ごとに改善を重ねたい" },
  { name: "法人AI研修（9回パッケージ）", tag: "6名〜", txt: "45分×9回に準備回を加えた研修です。実業務を題材に6ステップで進め、1か月後のAI利用率を経営者へ報告します。", fit: "複数の社員が、実務でAIを使う機会をつくりたい" },
];

const stairs = [
  { name: "お願いする", txt: "文章の作成など、タスクを1つずつAIに頼む。", seminar: "初級" },
  { name: "結びつける", txt: "作業とデータをつなぎ、情報を使って仕事を進める。", seminar: "中級" },
  { name: "自動化する", txt: "人が触らなくても、作業が回る。", seminar: "中級" },
  { name: "主体的に提案する", txt: "話しかけると、AIが方針に沿って次の進め方を提案する。", seminar: "上級" },
  { name: "AIから動く", txt: "AIが方針に基づいて自分から情報を集め、人に声をかける。", seminar: "上級" },
];

const details = [
  {
    id: "consultation",
    icon: "talk",
    en: "First consultation",
    name: "初回相談",
    tag: "無料",
    photo: { src: "fv-consult", alt: "相談の場で、PCを操作しながら説明する川端康平", w: 753, h: 941 },
    catch: "やりたい仕事を、その場で形に。",
    txt: "「この仕事をAIに任せたい」というテーマを1つお持ちください。現役エンジニアが相談の場で実際に作り、動かしてお見せします。オンライン・訪問のどちらにも対応しています。",
    for: ["自社の仕事にAIが使えるか、実物を見て確かめたい", "手間のかかる業務があり、どこから手をつけるか相談したい"],
    incl: ["やりたいことを1つヒアリング", "対象業務でのAIの使いどころの確認", "その場での作成と動作の実演"],
    goal: "自社の業務でAIに任せたいことが、具体的になります。",
  },
  {
    id: "session",
    icon: "laptop",
    en: "AI adoption session",
    name: "初回AI導入セッション",
    tag: "2時間",
    photo: { src: "chain-1", alt: "相談の場で、PCを操作する川端康平", w: 1000, h: 750 },
    catch: "いつもの業務を、2時間で変える。",
    txt: "5名程度までの少人数で、実際の業務を題材に取り組みます。AIに任せられる業務を整理し、Claude等の導入から実務で使うところまで進めます。",
    for: ["まずは経営者や数名の担当者で使い始めたい", "導入して終わりではなく、日々の仕事で使うところまで進めたい"],
    incl: ["業務のヒアリングと、AIに任せられる業務の整理", "AI活用の5段階による現在地の判定", "Claude等の導入", "実業務を1つ改善する実践"],
    goal: "自社での使いどころを、1つの業務で実感できます。",
  },
];

const orgIssues = [
  { icon: "graduate", name: "受講して終わる", txt: "研修が現場の業務につながらず、使われないまま終わります。" },
  { icon: "laptop", name: "ITの土台でつまずく", txt: "ファイル操作などの入口でつまずき、使う前に諦めてしまいます。" },
  { icon: "talk", name: "答えが一般論になる", txt: "会社の考え方を渡さないと、AIの答えが自社の判断に結びつきません。" },
];

const orgRisks = [
  { name: "情報漏えい・個人情報", txt: "入力してよい情報を線引きします。" },
  { name: "誤回答", txt: "根拠を確かめ、最終判断は人が行います。" },
  { name: "属人化", txt: "手順をスキルとして共有します。" },
  { name: "AI依存", txt: "判断の理由を残します。" },
  { name: "ツールの乱立", txt: "使うツールと管理者をそろえます。" },
];

const extras = [
  { icon: "app", name: "業務アプリ開発", txt: "顧問の時間では収まらない業務アプリや自動化を、現役エンジニアが開発します。", href: "/consultation" },
  { icon: "web", name: "Web制作", txt: "AI活用に付随するWebサイトの制作もご相談いただけます。", href: "/web" },
  /* 助成金・補助金は提携パートナーが担当するため、詳しい説明ページは置かない（2026-10-02 本人判断） */
  { icon: "subsidy", name: "助成金・補助金の相談", txt: "活用できる制度は、提携する専門家と連携してご案内します。", href: "/consultation" },
];

const faq = [
  { q: "一騎当千コースとAI軍師コース、どちらを選べばよいですか？", a: "会社の規模ではなく、変えたい仕事で選びます。社長ご自身の仕事を変えるなら一騎当千コース、社員や部署へ広げるならAI軍師コースです。社長が先に一騎当千コースで使い、AI軍師コースで社員へ広げる順番もおすすめです。" },
  { q: "費用はどのように決まりますか？", a: "時間単位・人数単位の標準料金をもとに、初回相談で業務を伺って必要な分だけをご提案します。標準料金は資料でご覧いただけます。" },
  { q: "どのAIを使いますか？", a: "主にClaudeを使います。導入するAIは、相談で伺う業務内容に合わせて決めます。" },
  { q: "ITが苦手でも大丈夫ですか？", a: "はい。AIを学ぶ科目ではなく、日本語で頼めばPCが動く、新しい操作の型として扱います。実際の仕事を題材に、操作しながら進めます。" },
  { q: "AI軍師コースの顧問と研修は、どう違いますか？", a: "人数で選びます。5名ほどまでなら、時間単位で業務ごとに改善を重ねる顧問。6名以上なら、9回パッケージの研修で全員の使い方をそろえます。" },
  { q: "卒業後はどうなりますか？", a: "育てた社内の展開役を中心に、日々の業務でAIを使い続けていただきます。支援を続けることを前提にせず、社内で進められることを卒業の目安にしています。" },
];
/* 公開・運用とセキュリティ（2026-10-08）。「防げる」と断言しない */
const securityMenu = [
  { name: "公開前チェック", txt: "アプリの設定を確認し、公開前に見直す点をお伝えします。" },
  { name: "修正", txt: "見つかった問題の直し方を提案し、修正作業まで対応します。" },
  { name: "インフラの選定・設計・構築", txt: "利用人数や扱うデータに合わせて、アプリを動かすサーバーやクラウドの構成を選び、必要な備えを設計・構築します。" },
  { name: "公開後の運用", txt: "公開後の稼働状況や更新を見守り、運用を支援します。" },
];
const securityFor = [
  "AIでアプリを作ったものの、公開してよいか迷っている",
  "直すべき点が分かっても、自社では修正が難しい",
  "公開後のサーバー管理や更新を任せたい",
];

---

<Layout
  title="サービス｜DDDynamis・AI軍師"
  description="DDDynamisは、一人を強化する一騎当千コースと、組織でAIを活用するAI軍師コースで、人数や関わり方に合わせて必要な分だけ支援します。社内の展開役を育て、自走したら卒業。無料の初回相談では、やりたいことをその場で動く形にしてお見せします。"
  corp
>
  <main id="corp-page" class="corp-page cp-service-page" role="main">
    <header class="cp-page-head">
      <div class="cp-container">
        <p class="cp-head__en eng" data-reveal>Service</p>
        <h1 class="cp-page-head__ttl" data-reveal style="--d: .1s">サービス</h1>
        <p class="cp-page-head__lead" data-reveal style="--d: .2s">必要な分だけ、一緒にやります。<br />ゴールは、私たちがいなくてもAIを活用できる会社です。</p>
      </div>
    </header>

    <!-- 0. 2つのコース -->
    <section class="cp-sec cp-sec--gray" aria-labelledby="course-ttl">
      <span class="cp-watermark eng" aria-hidden="true">COURSE</span>
      <div class="cp-container">
        <header class="cp-head" data-reveal>
          <p class="cp-head__en eng">Courses</p>
          <h2 class="cp-head__ttl" id="course-ttl">2つのコース</h2>
          <p class="cp-head__lead">一人を強化するなら一騎当千、組織で活用するならAI軍師。進め方は、人数や関わり方に合わせて選べます。</p>
        </header>
        <div class="cs-courses">
          {courses.map((c, i) => (
            <article class="cs-courses__item" id={c.id} data-reveal style={`--d: ${i * 0.1}s`}>
              <p class="cs-courses__en eng">{c.en}</p>
              <h3 class="cs-courses__name">{c.name}</h3>
              <p class="cs-courses__catch">{c.catch}</p>
              <p class="cs-courses__txt">{c.txt}</p>
              <dl class="cs-courses__rows">
                {c.rows.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
              </dl>
              <a href={c.href} class="cp-link cs-courses__more">中身を見る</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 1. 一騎当千コース：AI活用の5段階 -->
    <section class="cp-sec" id="ikki-course" aria-labelledby="stairs-ttl" style="scroll-margin-top: 100px">
      <span class="cp-watermark eng" aria-hidden="true">STAGE</span>
      <div class="cp-container">
        <header class="cp-head" data-reveal>
          <p class="cp-head__en eng">Ikki-tousen course</p>
          <h2 class="cp-head__ttl" id="stairs-ttl">一騎当千コース：AI活用の5段階を登る</h2>
          <p class="cp-head__lead">ご自身の仕事で、この5段階を一段ずつ登ります。1つずつ仕事を頼むところから、AIが自分から動く秘書まで。最初の導入セッションで、いまの段階を確かめます。</p>
        </header>
        <ol class="cs-stairs">
          {stairs.map((s, i) => (
            <li class="cs-stairs__step" data-reveal style={`--d: ${i * 0.1}s`}>
              {i === 0 && <span class="cs-stairs__here">多くの人はここ</span>}
              <p class="cs-stairs__no eng"><small>STAGE</small>{i + 1}</p>
              <p class="cs-stairs__name">{s.name}</p>
              <p class="cs-stairs__txt">{s.txt}</p>
              <p class="cs-stairs__seminar">セミナー{s.seminar}</p>
            </li>
          ))}
        </ol>
        <p class="cs-stairs-note" data-reveal>段階1から一段ずつ。<em>あなたの仕事に必要な段階</em>まで進めます。</p>

        <h3 class="cs-subhead" data-reveal>進め方</h3>
        <div class="cs-sizes cs-sizes--ways">
          {ikkiWays.map((w, i) => (
            <article class="cs-sizes__item" data-reveal style={`--d: ${i * 0.1}s`}>
              <p class="cs-sizes__size">{w.name}</p>
              <p class="cs-sizes__way">{w.tag}</p>
              <p class="cs-sizes__how">{w.txt}</p>
              <dl class="cs-sizes__goal"><dt>向く方</dt><dd>{w.fit}</dd></dl>
            </article>
          ))}
        </div>

        <p class="cs-doc-cta" data-reveal><span>セミナー各回の中身と料金は、資料でご覧いただけます。</span><a href="/document" class="cp-btn cp-btn--ghost">資料を受け取る（無料）</a></p>
      </div>
    </section>

    <!-- 2. AI軍師コース：組織で使う（会社のAIを一つにする） -->
    <section class="cp-sec cp-sec--gray" id="org" aria-labelledby="org-ttl" style="scroll-margin-top: 100px">
      <span class="cp-watermark eng" aria-hidden="true">TEAM</span>
      <div class="cp-container">
        <header class="cp-head" data-reveal>
          <p class="cp-head__en eng">AI Gunshi course</p>
          <h2 class="cp-head__ttl" id="org-ttl">AI軍師コース：会社のAIを、一つにする。</h2>
          <p class="cp-head__lead">AIは導入しても、組織では使われずに終わりがちです。必要なのは、会社共通のAIと、使い続ける仕組みです。</p>
        </header>

        <ul class="cs-org-issues">
          {orgIssues.map((x, i) => (
            <li data-reveal style={`--d: ${i * 0.08}s`}>
              <LineIcon name={x.icon} size={40} />
              <p class="cs-org-issues__name">{x.name}</p>
              <p class="cs-org-issues__txt">{x.txt}</p>
            </li>
          ))}
        </ul>

        <h3 class="cs-subhead" data-reveal>進め方は、人数で選びます</h3>
        <div class="cs-sizes cs-sizes--ways cs-sizes--two">
          {gunshiWays.map((w, i) => (
            <article class="cs-sizes__item" data-reveal style={`--d: ${i * 0.1}s`}>
              <p class="cs-sizes__size">{w.name}</p>
              <p class="cs-sizes__way">{w.tag}</p>
              <p class="cs-sizes__how">{w.txt}</p>
              <dl class="cs-sizes__goal"><dt>向く方</dt><dd>{w.fit}</dd></dl>
            </article>
          ))}
        </div>

        <h3 class="cs-subhead" data-reveal>限界とリスクは、運用ルールで抑えます</h3>
        <ul class="cs-risks" data-reveal>
          {orgRisks.map((r) => <li><span class="cs-risks__name">{r.name}</span><span class="cs-risks__txt">{r.txt}</span></li>)}
        </ul>
        <p class="cs-risks-note" data-reveal>AIの出力はそのまま使わず、確認と情報の整理は人の役割として残します。</p>
        <p class="cs-doc-cta" data-reveal><span>進め方の詳細・9回パッケージの中身・料金は、資料でご覧いただけます。</span><a href="/document" class="cp-btn cp-btn--ghost">資料を受け取る（無料）</a></p>
      </div>
    </section>

    <!-- 2.5 公開・運用とセキュリティ（2026-10-08 本人指示：差別化の柱）。トップの節（原因・確認項目の図解）と内容を重ねず、頼める作業を見せる -->
    <section class="cp-sec cs-security" aria-labelledby="security-ttl">
      <span class="cp-watermark eng" aria-hidden="true">SECURITY</span>
      <div class="cp-container">
        <header class="cp-head" data-reveal>
          <p class="cp-head__en eng">Security &amp; operations</p>
          <h2 class="cp-head__ttl" id="security-ttl">AIで作ったアプリの、<br />公開と運用まで。</h2>
          <p class="cp-head__lead">サイバー被害が激増しています。公開に必要な作業を、アプリの状態に合わせてご依頼いただけます。作成済みのアプリも、確認から修正、運用まで対応します。</p>
        </header>
        <ol class="cs-security__menu">
          {securityMenu.map((m, i) => (
            <li data-reveal style={`--d: ${i * 0.08}s`}>
              <p class="cs-security__name">{m.name}</p>
              <p class="cs-security__txt">{m.txt}</p>
            </li>
          ))}
        </ol>
        <div class="cs-security__for" data-reveal>
          <p>こんな方に</p>
          <ul>{securityFor.map((x) => <li>{x}</li>)}</ul>
        </div>
        <p class="cs-security__more" data-reveal><a href="/security" class="cp-link">公開前チェックについて詳しく見る</a></p>
      </div>
    </section>

    <!-- 3. はじめ方（両コース共通） -->
    <section class="cp-sec" aria-labelledby="detail-ttl">
      <span class="cp-watermark eng" aria-hidden="true">SERVICE</span>
      <div class="cp-container">
        <header class="cp-head" data-reveal>
          <p class="cp-head__en eng">Getting started</p>
          <h2 class="cp-head__ttl" id="detail-ttl">はじめ方</h2>
          <p class="cp-head__lead">どちらのコースも、初回相談と導入セッションから始めます。</p>
        </header>

        <div class="cs-details">
          {details.map((d, i) => (
            <article class={`cs-detail${i % 2 === 1 ? " is-rev" : ""}`} id={d.id} aria-labelledby={`${d.id}-ttl`}>
              <span class="cs-detail__num eng" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <figure class="cs-detail__photo" data-reveal>
                <picture>
                  <source srcset={`/assets/images/corp/${d.photo.src}.webp`} type="image/webp" />
                  <img src={`/assets/images/corp/${d.photo.src}.jpg`} alt={d.photo.alt} width={d.photo.w} height={d.photo.h} loading="lazy" decoding="async" />
                </picture>
              </figure>
              <div class="cs-detail__body">
                <div data-reveal>
                  <p class="cs-detail__label"><LineIcon name={d.icon} size={40} /><span class="cs-detail__en eng">{d.en}</span></p>
                  <h3 class="cs-detail__name" id={`${d.id}-ttl`}>{d.name}{d.tag && <span class="cs-detail__tag">{d.tag}</span>}</h3>
                  <p class="cs-detail__catch">{d.catch}</p>
                  <p class="cs-detail__txt">{d.txt}</p>
                </div>
                <div class="cs-detail__box" data-reveal style="--d: .1s">
                  <div>
                    <p class="cs-detail__box-ttl">こんな会社に</p>
                    <ul class="cs-detail__for">{d.for.map((x) => <li>{x}</li>)}</ul>
                  </div>
                  <div>
                    <p class="cs-detail__box-ttl">含まれること</p>
                    <ul class="cs-detail__incl">{d.incl.map((x) => <li>{x}</li>)}</ul>
                  </div>
                </div>
                <p class="cs-detail__goal" data-reveal style="--d: .15s"><LineIcon name="flag" size={32} /><span>{d.goal}</span></p>
              </div>
            </article>
          ))}
        </div>

        <!-- 付随する相談 -->
        <div class="cp-extras cs-extras" data-reveal>
          <p class="cp-extras__ttl" id="extra-ttl">あわせてご相談いただけること</p>
          <ul class="cp-extras__list">
            {extras.map((e) => (
              <li>
                <a href={e.href}>
                  <LineIcon name={e.icon} size={36} />
                  <span class="cp-extras__name">{e.name}</span>
                  <span class="cp-extras__txt">{e.txt}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. よくある質問 -->
    <section class="cp-sec cp-sec--gray" aria-labelledby="faq-ttl">
      <div class="cp-container">
        <header class="cp-head cp-head--center" data-reveal>
          <p class="cp-head__en eng">FAQ</p>
          <h2 class="cp-head__ttl" id="faq-ttl">よくある質問</h2>
        </header>
        <div class="cs-faq" data-reveal>
          {faq.map((f) => (
            <details class="cs-faq__item">
              <summary><span class="cs-faq__q">Q</span><span>{f.q}</span></summary>
              <p class="cs-faq__body"><span class="cs-faq__a">A</span><span>{f.a}</span></p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 初回相談へ -->
    <section class="cp-closing" aria-labelledby="sv-closing">
      <picture class="cp-closing__band" aria-hidden="true">
        <source media="(min-width: 769px)" srcset="/assets/images/corp/band-connect.webp" type="image/webp" />
        <source media="(min-width: 769px)" srcset="/assets/images/corp/band-connect.jpg" />
        <source srcset="/assets/images/corp/band-connect-sp.webp" type="image/webp" />
        <img src="/assets/images/corp/band-connect-sp.jpg" alt="" width="800" height="600" loading="lazy" decoding="async" />
      </picture>
      <div class="cp-container cp-closing__inner" data-reveal>
        <h2 class="cp-closing__ttl" id="sv-closing">まずは、やりたいことを1つ。</h2>
        <p class="cp-closing__txt">その仕事をAIに任せるとどう変わるか、初回相談で一緒に確かめましょう。初回相談は無料です。</p>
        <a href="/consultation" class="cp-btn cp-btn--primary cp-btn--lg">初回相談について</a>
        <a href="/document" class="cp-btn cp-btn--ghost cp-btn--lg cs-closing-doc">資料を受け取る</a>
      </div>
    </section>
  </main>
</Layout>
