---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/top/hero/Hero.astro";
import Challenges from "../../components/top/Challenges.astro";
import Shift from "../../components/top/Shift.astro";
import Service from "../../components/top/Service.astro";
import PhotoBand from "../../components/top/PhotoBand.astro";
import Profile from "../../components/top/Profile.astro";
import Plan from "../../components/top/Plan.astro";
import Flow from "../../components/top/Flow.astro";
import ContactForm from "../../components/ContactForm.jsx";
---

<Layout
  title="AX for small businesses | Kohei Kawabata"
  description="Not how to use AI — rebuilding how the work runs. Two hours to automate one real task, and support until your staff can change it themselves."
  lang="en"
>
  <!-- 構造化データ（JSON-LD） -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "Dynamis",
      url: "https://dddynamis.com/en/",
      description:
        "AX support for small businesses: process redesign, automation, and support until the team runs it alone.",
      areaServed: "JP",
      founder: {
        "@type": "Person",
        name: "Kohei Kawabata",
        jobTitle: "AI活用支援コンサルタント / Webエンジニア",
      },
    })}
  />
  <!-- main -->
  <main id="top" role="main">
    <Hero />
    <Challenges />
    <Shift />
    <Service />
    <PhotoBand />
    <Profile />
    <Plan />
    <Flow />
    <ContactForm lang="en" client:visible />
  </main>
</Layout>
