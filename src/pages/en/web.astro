---
import Layout from "../../layouts/Layout.astro";
import WebPlan from "../../components/web/WebPlan.astro";
---

<Layout
  title="Dynamis | Web & System Development"
  description="Website creation and renewal, multilingual support, and business system development, handled by a working web engineer."
  lang="en"
>
  <!-- main -->
  <main id="web" class="web" role="main">
    <div class="pageheader">
      <h1 class="pageheader-ttl">
        <span class="eng">Web Development</span>
        Web &amp; System Development
      </h1>
    </div>
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <div class="container">
        <ol
          itemscope
          itemtype="https://schema.org/BreadcrumbList"
          class="breadcrumb-list"
        >
          <li
            class="breadcrumb-list__item"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            <a itemprop="item" href="/en/">
              <span itemprop="name">Home</span>
            </a>
            <meta itemprop="position" content="1" />
          </li>
          <li
            class="breadcrumb-list__item"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            <span itemprop="name">Web &amp; System Development</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </div>
    </nav>

    <section class="web-intro">
      <div class="container">
        <p class="web-intro__lead">
          Alongside AI adoption support, I also build websites and business systems.
        </p>
        <p class="web-intro__txt desc">
          Website creation and renewal, multilingual support, analytics setup, and ongoing maintenance.
          When automating the work calls for a business app or a system, the same person designs and builds it.
        </p>
        <a href="/en/work-archive" class="web-intro__link">View works</a>
      </div>
    </section>

    <WebPlan />

    <section class="web-cta">
      <div class="container">
        <div class="cta">
          <p class="cta-p">Start with a conversation</p>
          <a href="/en/#contact" class="cta-link">Get in touch</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
