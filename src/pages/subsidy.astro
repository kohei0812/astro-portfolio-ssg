---
import Layout from "../layouts/Layout.astro";
import SubsidyBody from "../components/subsidy/SubsidyBody.astro";
---

<Layout
  title="業務改善助成金という選択肢 | Dynamis"
  description="AI導入や業務改善にかけた費用が助成の対象になる場合があります。賃上げとあわせて生産性向上に取り組む中小企業向けの制度です。"
>
  <main id="subsidy-page" class="subsidy-page" role="main">
    <div class="pageheader">
      <h1 class="pageheader-ttl">
        <span class="eng">Subsidy</span>
        業務改善助成金という選択肢
      </h1>
    </div>
    <nav aria-label="パンくずリスト" class="breadcrumb">
      <div class="container">
        <ol itemscope itemtype="https://schema.org/BreadcrumbList" class="breadcrumb-list">
          <li class="breadcrumb-list__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a itemprop="item" href="/"><span itemprop="name">ホーム</span></a>
            <meta itemprop="position" content="1" />
          </li>
          <li class="breadcrumb-list__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span itemprop="name">業務改善助成金</span>
            <meta itemprop="position" content="2" />
          </li>
        </ol>
      </div>
    </nav>
    <SubsidyBody />
    <section class="subsidy-cta">
      <div class="container">
        <div class="cta">
          <p class="cta-p">使えるかどうか、一緒に確認します</p>
          <a href="/#contact" class="cta-link">無料で相談する</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
