---
/*
  AIで作ったアプリの公開前チェック（2026-10-08 新設。本人指示：差別化の柱「インフラ・セキュリティ」の専用ページ）。
  検索・SNS・広告からの受け皿。トップ・サービス・LP・Web の節からここへつなぐ。
  文言：Codex 案（scratchpad/codex/security_page.md）を図解の語に合わせて手直し。素材 GD/営業/マーケ運用/情報漏えい事例調査_20261008.md
  表現ルール：「防げる」「安全」「保証」と断言しない／社名を出さない／「作っていい。公開の前に確かめよう」の立場。
  図解は ChatGPT で作成（原本 GD/営業/サイト素材/図解_ChatGPT_20261003/security-*_20261008.png）。
  スタイルは _corp-security.scss（.cp-security-page）。
  2026-10-23 LP化（本人指示：PHP緊急脆弱性の広告の着地）：Layout は lp（ナビなし・追従CTA）＋ corp（corp.js）。ボタンはすべてページ内フォーム #contact へ。
  構成の根拠は 営業/広告/2026-10_PHP緊急脆弱性/LP研究_PHP脆弱性LP構成_20261023.md。文言は Codex（scratchpad/codex/lp_copy.md）。
  2026-10-25 入口商品「無料Webサイト簡易診断」を載せる（本人指示：「相談して」止まりをやめ、最速でコンバージョンを取る）。
  2026-10-25 同日、商品名を「PHPチェッカー」に（本人決定。文言 diag_copy_v2.json）。ボタンはすべて診断の申し込みへ。フォームは ConsultForm の mode="diagnosis"。文言は Codex（GD/営業/広告/2026-10_PHP緊急脆弱性/無料診断_文言_20261025.json）。
  2026-11-03 作り直し（本人指示「写真やイラストが少なくて読みにくい」「採れるLPに」）：
  AIで作ったアプリの公開前チェック〜保守と「インターネット通信は戦争状態」の FV は /security/ai-app に分離し、ここは PHPチェッカーの LP に絞った。
  構成・画像の根拠は 営業/広告/2026-10_PHP緊急脆弱性/LP研究_日本LPの力学_20261103.md §9（12節）。新しい文言は Codex（scratchpad/codex_lp1103/copy.json）を手直し。
  イラストは ChatGPT（白・青・金、文字なし）、代表は実写（8/3 撮影）。フォームは現行の4項目・1画面・その場で簡易結果のまま（本人指示）。
*/
import Layout from "../layouts/Layout.astro";
import PartnerTechnoKuro from "../components/corp/PartnerTechnoKuro.astro";
import LineIcon from "../components/corp/LineIcon.astro";
import DiagnosisForm from "../components/consultation/DiagnosisForm.jsx";

/* PHPチェッカー＝無料Webサイト簡易診断（外から見える範囲だけ。所有者確認ができないサイトは診断しない） */
const diagChecks = [
  { icon: "layers", name: "ソフトの版", txt: "PHP・WordPress・追加機能の版と既知の弱点を確認します。" },
  { icon: "lock", name: "通信の暗号化", txt: "SSLと証明書を確認します。" },
  { icon: "doc", name: "公開ファイル", txt: "設定ファイル・バックアップ・.gitなどの公開を確認します。" },
  { icon: "door", name: "管理画面の露出", txt: "管理画面が外から見える状態かを確認します。" },
  { icon: "gear", name: "保護の設定", txt: "通信のセキュリティ設定を点検します。" },
  { icon: "mail", name: "なりすまし対策", txt: "SPF・DMARCの有無と弱さを確認します。" },
];
const diagSteps = [
  { name: "4つを入力", txt: "会社名・お名前・サイトのURL・メールアドレスを入れます。" },
  { name: "その場で簡易結果", txt: "通信の設定を外から確かめ、この画面に結果を出します。" },
  { name: "メールで所有者確認", txt: "本診断の前に、ご入力のメールでサイトの所有者を確認します。ログインの試行や攻撃にあたる検査は行いません。" },
  { name: "結果をお持ちして説明", txt: "本診断の結果を「今すぐ対応／近いうちに対応／様子見」の3段にまとめ、川端がお持ちしてご説明します。" },
];


/* PHP 緊急脆弱性のファーストビュー（2026-10-23 本人指示：PHP危機に便乗、完全に煽り。広告・SNS PHP01〜03 の着地）
   文言は Codex 作成（scratchpad/codex/php_ads.md）。事実は PHP 公式（2026-10-21）と国内報道で確認。社名・人名は出さない */
const phpChecks = [
  "WordPressで作っています",
  "PHPのバージョンを知りません",
  "社員がAIで作ったアプリを公開しています",
  "更新する担当者が決まっていません",
];
const phpServices = [
  { name: "PHPの更新", txt: "サーバーのPHPそのものを、修正版（8.5.12／8.4.27／8.3.36／8.2.35）以上へ更新し、表示やお問い合わせフォームの動きまで確認します。修正版のない古いPHPからの移行も対応します。" },
  { name: "セキュリティの見直し", txt: "PHP、WordPress、プラグイン、AIで作ったアプリ、管理画面まで、攻撃の入口になり得る箇所を確認します。秘密鍵の管理、バックアップ、復旧手順まで見直します。" },
  { name: "サーバーの引っ越し", txt: "更新や復旧を続けられる環境へ、サイトとデータを移します。サーバー会社がどこまで対応するかを確かめ、自社で管理すべきことと担当者をはっきりさせます。" },
];

/* 恐怖のあとに安心へ切り替える（LP研究 §8）。しないことの約束（Codex 案） */
const promises = [
  { icon: "nologin", name: "ログインを試さない", txt: "利用者名やパスワードを入力して、管理画面に入ろうとすることはありません。" },
  { icon: "noattack", name: "攻撃の検査はしない", txt: "サイトの弱点を突くなど、攻撃にあたる検査は行いません。" },
  { icon: "owner", name: "確認なしで進めない", txt: "所有者確認ができないサイトは、本診断しません。" },
];

/* 料金表（2026-11-03 定期診断は年額12万円・税別・契約期間1年。1日あたりの言い換えは Shido 鈴木様の助言。12万÷365≒329円） */
const priceRows = [
  { name: "PHPチェッカー", price: "無料", note: "簡易診断・本診断・結果のご説明まで含みます。" },
  { name: "定期診断", price: "年額12万円（税別）", sub: "契約期間1年", note: "1日あたり約330円（税別）で、毎週外から点検し直します。変化があったときだけ川端がメールでお知らせします。改修は含みません。" },
  { name: "詳細診断と報告会・改修・保守", price: "お見積り", note: "必要な作業と費用をお伝えし、お見積りを見てからご判断いただけます。" },
];

const faq = [
  { q: "PHPチェッカーは、PHPだけを調べるのですか？", a: "PHPを入り口に、サイト全体を外から見える範囲で点検します。WordPress・追加機能の版と既知の弱点、SSLと証明書、公開されてはいけないファイル、管理画面の露出、セキュリティ関連の設定も対象です。なりすましメール対策は、そのドメインの公開DNSで確認し、メールの送受信は行いません。" },
  { q: "所有者確認は、どのように行いますか？", a: "ご入力のメールアドレスのドメイン（@以降）が対象サイトと同じ場合は、そのまま点検へ進みます。異なる場合は、確認用の文字列をトップページかDNSに置いていただきます。確認できないサイトは診断しません。" },
  { q: "見つかった箇所の対応も頼めますか？", a: "詳細診断と報告会、改修、保守も承ります。ご利用は任意ですので、お見積りを見てからご判断いただけます。" },
  { q: "古いPHPのサイトでも対応できますか？", a: "まず現在の構成を確認し、更新による影響を調べます。そのうえで、移行も含めた対応方法を検討します。" },
  { q: "制作会社と連絡が取れません。", a: "サーバー契約や管理画面へのアクセス状況から、確認できることを探します。資料がそろっていなくても、手元にある情報でご相談ください。" },
  { q: "レンタルサーバーでも確認は必要ですか？", a: "レンタルサーバーでも、利用中のPHPが今回の脆弱性の影響を受けるか確認が必要です。サーバー会社の対応状況と、ご自身で必要な設定変更を確認します。" },
  { q: "PHPチェッカーの費用はいくらですか？", a: "PHPチェッカーによるWebサイトの簡易診断は無料です。" },
  { q: "定期診断は、どのようなサービスですか？", a: "定期診断は、無料のPHPチェッカーで所有者確認が済んだサイトを毎週、外から点検し直すサービスです。年額12万円（税別）で、契約期間は1年です。改修は含みません。ログインの試行や攻撃にあたる検査は行いません。" },
];
---
<Layout
  title="あなたのWebサイト、PHP使ってないですか？｜無料のWebサイト簡易診断 PHPチェッカー｜DDDynamis・AI TANK"
  description="2026年10月21日、PHPに緊急レベルの脆弱性が公表されました。WordPressやPHPの自社サイトを、無料のPHPチェッカーでその場で簡易診断できます。本診断・更新・引っ越しまで、現役Webエンジニアが直接対応します。"
  corp
  lp
  lpCta={{ header: "無料で簡易診断", sticky: "無料で簡易診断する" }}
  lpNav={[{ href: "#diagnosis", label: "PHPチェッカー" }, { href: "/security/ai-app", label: "アプリ公開サービス" }]}
  lpTagline="現役Webエンジニアが直接対応します。"
>
  <main id="corp-page" class="corp-page cp-security-page" role="main">
    <!-- 1. FV：対象の名指し＋無料・その場で結果＋代表の実写（LP研究 §2・§9） -->
    <section class="sp-php" aria-labelledby="sp-php-ttl">
      <div class="cp-container">
        <div class="sp-php__fv">
          <div class="sp-php__fvcopy">
            <p class="sp-php__label" data-reveal>2026年10月21日 PHPに緊急の脆弱性</p>
            <h1 class="sp-php__ttl" id="sp-php-ttl" data-reveal style="--d: .1s"><span class="sp-php__nb">あなたのWebサイト、</span><span class="sp-php__nb"><em>PHP</em>使ってないですか？</span></h1>
            <p class="sp-php__sub" data-reveal style="--d: .2s">PHPチェッカーは、PHPやWordPressで作った自社サイトを、外から無料で簡易診断します。結果はその場で画面に出ます。</p>
            <div class="sp-cta sp-cta--fv" data-reveal style="--d: .3s">
              <a href="#contact" class="sp-cta__btn">無料で簡易診断する</a>
              <p class="sp-cta__note">4つ入れるだけ。攻撃にあたる検査はしません。</p>
            </div>
          </div>
          <figure class="sp-fvphoto" data-reveal style="--d: .2s">
            <picture>
              <source srcset="/assets/images/consultation/fv-kawabata.webp" type="image/webp" />
              <img src="/assets/images/consultation/fv-kawabata.jpg" alt="DDDynamis代表・現役Webエンジニアの川端康平" width="861" height="1236" decoding="async" fetchpriority="high" />
            </picture>
            <figcaption><b>川端康平</b>DDDynamis代表・現役Webエンジニア<br />自社の本番サーバーも自分で設計・運用しています</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2. 悩みチェック＋困った店主のイラスト -->
    <section class="cp-sec sp-split-sec" aria-labelledby="sp-worry-ttl">
      <div class="cp-container sp-split">
        <div class="sp-split__txt">
          <h2 class="sp-php__h" id="sp-worry-ttl" data-reveal>ひとつでも当てはまれば、まず点検を</h2>
          <ul class="sp-php__checks" data-reveal>
            {phpChecks.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <figure class="sp-split__img" data-reveal style="--d: .1s">
          <picture>
            <source srcset="/assets/images/corp/security-lp-worried.webp" type="image/webp" />
            <img src="/assets/images/corp/security-lp-worried.jpg" alt="サーバー会社からの通知メールを見て、首をかしげる店主のイラスト" width="1536" height="1024" loading="lazy" decoding="async" />
          </picture>
        </figure>
      </div>
    </section>

    <!-- 3. 何が起きたか（事実・出典・日付）。2026-11-03 本人指示でイラストを追加 -->
    <section class="cp-sec cp-sec--gray sp-split-sec" aria-labelledby="sp-what-ttl">
      <div class="cp-container sp-split">
        <div class="sp-split__txt sp-php__more" data-reveal>
          <h2 class="sp-php__h" id="sp-what-ttl">PHPを皮切りに、弱点の公表が日々続く</h2>
          <p>2026年10月21日、PHPに緊急レベルの脆弱性が公表されました。外からプログラムを実行されてサーバーを乗っ取られるおそれがあり、WordPressで作ったサイトやPHPのお問い合わせフォームも対象です。PHP 8.1以前には公式の修正版がなく、プラグインの更新だけでは直りません。</p>
          <p>PHPだけの話ではありません。Python・Node.js、WordPress・Laravel・Next.jsなど、ほぼすべての言語・部品で弱点の公表が続いています。私たちが使うインターネット全体の話です。</p>
          <p class="sp-php__src">出典：<a href="https://www.php.net/archive/2026.php#2026-10-21-5" target="_blank" rel="noopener">PHP公式の告知（2026年10月21日）</a>。修正版は 8.5.12／8.4.27／8.3.36／8.2.35 以上。<time datetime="2026-10-23">2026年10月23日</time>時点の情報です。</p>
        </div>
        <figure class="sp-split__img" data-reveal style="--d: .1s">
          <picture>
            <source srcset="/assets/images/corp/security-lp-wave.webp" type="image/webp" />
            <img src="/assets/images/corp/security-lp-wave.jpg" alt="サイトを支える部品に、次々と警告マークが点き、カレンダーの毎日にも警告が並ぶイラスト" width="1536" height="1024" loading="lazy" decoding="async" />
          </picture>
        </figure>
      </div>
    </section>

    <!-- 4. 安心への切り替え（AI TANK の聖騎士はここで初登場） -->
    <section class="cp-sec sp-split-sec" aria-labelledby="sp-relief-ttl">
      <div class="cp-container sp-split sp-split--rev">
        <div class="sp-split__txt">
          <h2 class="sp-php__h" id="sp-relief-ttl" data-reveal>外から、今日確かめられます</h2>
          <p class="sp-split__lead" data-reveal>本診断は、メールで所有者確認をしてから、外から見える範囲を点検します。結果は川端がお持ちして、何をどう見直すかをご説明します。すべての弱点を見つけられるものではありません。</p>
        </div>
        <figure class="sp-split__img" data-reveal style="--d: .1s">
          <picture>
            <source srcset="/assets/images/corp/security-lp-knight.webp" type="image/webp" />
            <img src="/assets/images/corp/security-lp-knight.jpg" alt="盾を構えた聖騎士が、後ろに並ぶ小さな店や事務所に飛んでくる矢を防いでいるイラスト" width="1536" height="1024" loading="lazy" decoding="async" />
          </picture>
        </figure>
      </div>
    </section>

    <!-- 5. PHPチェッカーで分かること＋結果の見本（入口商品 2026-10-25。11/03：4項目・その場で簡易結果 → 本診断はメールで所有者確認 → 結果を持参） -->
    <section class="cp-sec cp-sec--gray" aria-labelledby="sp-diag-ttl">
      <div class="cp-container">
        <div class="sp-diag" id="diagnosis" data-reveal>
          <p class="sp-diag__label eng">Free check</p>
          <h2 class="sp-diag__ttl" id="sp-diag-ttl">PHPチェッカー<span class="sp-diag__ttlsub">無料のWebサイト簡易診断</span></h2>
          <p class="sp-diag__lead">PHPを入り口に、サイト全体を外から点検します。中小企業・店舗のWordPress・PHPの自社サイトや、AIで作って公開したアプリが対象です。</p>
          <div class="sp-diag__cols">
            <div>
              <h3 class="sp-diag__h">本診断で点検する6つの項目</h3>
              <ul class="sp-diag__checks">
                {diagChecks.map((c) => <li class="sp-diag__check"><LineIcon name={c.icon} size={36} /><b>{c.name}</b>{c.txt}</li>)}
              </ul>
            </div>
            <!-- 結果の見本：その場で出る簡易結果（DiagnosisForm の3項目と同じ並び）。架空の結果と分かるよう「見本」と明記 -->
            <div class="sp-sample" aria-label="簡易結果の見本">
              <p class="sp-sample__tag">簡易結果の見本</p>
              <p class="sp-sample__url">https://example.com</p>
              <div class="sp-sample__grade"><span>簡易診断の評価</span><b class="eng">C</b></div>
              <ul class="sp-sample__items">
                <li class="is-ok"><b>通信の暗号化（https）</b>暗号化された https に案内されています。</li>
                <li class="is-ng"><b>ソフトの版の露出</b>サーバーが PHP の版の番号を外に出しています。</li>
                <li class="is-warn"><b>画面の乗っ取り対策</b>他のサイトに埋め込まれる対策が入っていません。</li>
              </ul>
              <p class="sp-sample__rest">残りの項目は、本診断で確かめます。</p>
            </div>
          </div>
          <p class="sp-diag__note">その場で出る簡易結果は、外から誰でも見られる通信の設定の一部です。所有者確認ができないサイトは本診断しません。すべての穴を見つける保証ではありません。</p>
          <div class="sp-cta">
            <a href="#contact" class="sp-cta__btn">無料で簡易診断する</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. 流れ（4ステップを1枚のイラストで） -->
    <section class="cp-sec" aria-labelledby="sp-flow-ttl">
      <div class="cp-container">
        <h2 class="sp-php__h sp-php__h--center" id="sp-flow-ttl" data-reveal>URLの入力から、結果のご説明まで</h2>
        <figure class="sp-flow__img" data-reveal>
          <picture>
            <source srcset="/assets/images/corp/security-lp-flow.webp" type="image/webp" />
            <img src="/assets/images/corp/security-lp-flow.jpg" alt="スマホで4つ入力、画面に簡易結果、メールで所有者確認、結果を持参して説明、の4つの場面のイラスト" width="1672" height="424" loading="lazy" decoding="async" />
          </picture>
        </figure>
        <ol class="sp-diag__steps sp-flow__steps">
          {diagSteps.map((s, i) => <li data-reveal style={`--d: ${i * 0.06}s`}><span class="sp-diag__no eng">{String(i + 1).padStart(2, "0")}</span><b>{s.name}</b>{s.txt}</li>)}
        </ol>
      </div>
    </section>

    <!-- 7. しないことの約束 -->
    <section class="cp-sec cp-sec--gray" aria-labelledby="sp-promise-ttl">
      <div class="cp-container">
        <h2 class="sp-php__h sp-php__h--center" id="sp-promise-ttl" data-reveal>PHPチェッカーで、しないこと</h2>
        <ul class="sp-promise">
          {promises.map((p, i) => (
            <li data-reveal style={`--d: ${i * 0.08}s`}>
              <LineIcon name={p.icon} size={44} />
              <p class="sp-promise__name">{p.name}</p>
              <p class="sp-promise__txt">{p.txt}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8. 代表：現役エンジニアが直接点検（相談風景は 8/3 撮影の実写。同席の方はぼかし済み） -->
    <section class="cp-sec" aria-labelledby="sp-who-ttl">
      <div class="cp-container sp-who sp-who--lp">
        <picture class="sp-who__photo" data-reveal>
          <source srcset="/assets/images/corp/security-lp-consult.webp" type="image/webp" />
          <img src="/assets/images/corp/security-lp-consult.jpg" alt="ノートPCの画面を見ながら、相談者に説明する川端康平" width="1600" height="900" loading="lazy" decoding="async" />
        </picture>
        <div>
          <header class="cp-head" data-reveal>
            <p class="cp-head__en eng">Engineer</p>
            <h2 class="cp-head__ttl" id="sp-who-ttl">現役エンジニアの私が<br />直接点検します</h2>
            <p class="cp-head__lead">DDDynamis代表の川端康平です。自社の本番サーバーも、私自身が設計・運用しています。サーバーへの入口を開けず、保存データとバックアップを暗号化し、毎日バックアップを取って、復元できることも確認しています。</p>
          </header>
          <p class="sp-who__end" data-reveal>結果は、専門用語だけで済ませず、何をどう見直すかが分かる言葉でお伝えします。</p>
          <div class="sp-cta sp-cta--left" data-reveal>
            <p class="sp-cta__lead">専門用語に直さず、そのままどうぞ</p>
            <a href="#contact" class="sp-cta__btn">無料で簡易診断する</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 9. 料金表（定期診断 2026-11-03 年額12万円・税別・契約期間1年。改修は含まない） -->
    <section class="cp-sec cp-sec--gray" id="monitor" aria-labelledby="sp-price-ttl">
      <div class="cp-container">
        <h2 class="sp-php__h sp-php__h--center" id="sp-price-ttl" data-reveal>料金</h2>
        <div class="sp-price" data-reveal>
          {priceRows.map((r) => (
            <div class="sp-price__row">
              <p class="sp-price__name">{r.name}</p>
              <p class="sp-price__val">{r.price}{r.sub && <span>{r.sub}</span>}</p>
              <p class="sp-price__note">{r.note}</p>
            </div>
          ))}
        </div>
        <p class="sp-price__foot" data-reveal>定期診断は、本診断の結果をご説明するときにご案内します。すべての穴を見つける保証ではありません。</p>
      </div>
    </section>

    <!-- 10. ご相談いただけること＋AIアプリのページへ -->
    <section class="cp-sec" aria-labelledby="sp-menu-ttl">
      <div class="cp-container">
        <h2 class="sp-php__h sp-php__h--center" id="sp-menu-ttl" data-reveal>ご相談いただけること</h2>
        <ul class="sp-php__services">
          {phpServices.map((v, i) => (
            <li data-reveal style={`--d: ${i * 0.08}s`}><p class="sp-php__name">{v.name}</p><p class="sp-php__txt">{v.txt}</p></li>
          ))}
        </ul>
        <!-- 作業はすべてお客様の環境で（2026-11-03 本人指示：出向またはリモートアクセス。データを持ち帰らない） -->
        <p class="sp-price__foot" data-reveal>作業はすべて訪問して（リモートでも対応可）、お客様の環境の中で行います。当方の手元にデータを持ち帰ることはありません。</p>
        <a href="/security/ai-app" class="sp-aicard" data-reveal>
          <span class="sp-aicard__ttl">AIで作ったアプリの公開前チェック</span>
          <span class="sp-aicard__txt">アプリの公開前に確認することや、公開・保守のご相談は、こちらでご案内しています。</span>
        </a>
      </div>
    </section>

    <!-- 相互リンク：TechnoKuRo（2026-11-09 提案用の仮置き） -->
    <PartnerTechnoKuro variant="section" />

    <!-- 11. よくある質問（PHPチェッカー関連だけ。AIアプリ関連は /security/ai-app へ移した） -->
    <section class="cp-sec cp-sec--gray" aria-labelledby="sp-faq-ttl">
      <div class="cp-container">
        <header class="cp-head cp-head--center" data-reveal>
          <p class="cp-head__en eng">FAQ</p>
          <h2 class="cp-head__ttl" id="sp-faq-ttl">よくある質問</h2>
        </header>
        <div class="sp-faq" data-reveal>
          {faq.map((f) => (
            <details class="sp-faq__item">
              <summary><span class="sp-faq__q eng">Q</span><span>{f.q}</span></summary>
              <p class="sp-faq__body"><span class="sp-faq__a eng">A</span><span>{f.a}</span></p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 12. 最終CTA＋ページ内フォーム（広告からの着地で離脱させない） -->
    <section class="cp-sec sp-final" aria-labelledby="sp-final-ttl">
      <div class="cp-container sp-final__in" data-reveal>
        <figure class="sp-final__img">
          <picture>
            <source srcset="/assets/images/corp/security-lp-final.webp" type="image/webp" />
            <img src="/assets/images/corp/security-lp-final.jpg" alt="盾を下ろした聖騎士の横で、ノートPCの画面を見て安心する店主のイラスト" width="1536" height="1024" loading="lazy" decoding="async" />
          </picture>
        </figure>
        <div>
          <h2 class="sp-final__ttl" id="sp-final-ttl">動かなくなる前に確かめましょう</h2>
          <p class="sp-final__txt">問い合わせが途切れてから、サイトの異常に気づくかもしれません。気になる方は、まずPHPチェッカーを使ってみてください。</p>
        </div>
      </div>
    </section>
    {/* フォームの装飾は初回相談LPと共用（_consultation-page.scss が #consultation-page の中だけに効くため、id をそろえる） */}
    <div class="sp-form" id="consultation-page">
      {/* 簡易診断フォーム（2026-11-03：4項目・2列・その場で結果。本診断はメールで所有者確認→結果を持参） */}
      <DiagnosisForm client:load />
    </div>
    <PartnerTechnoKuro variant="float" />
  </main>

  <script is:inline>
    // フォームが画面に入ったら追従CTAを隠す（/consultation と同じ。表示そのものは main.js がスクロール量で制御）
    document.addEventListener("DOMContentLoaded", () => {
      const sticky = document.getElementById("js-sticky-cta");
      const form = document.getElementById("contact");
      if (!sticky || !form || !("IntersectionObserver" in window)) return;
      new IntersectionObserver(([entry]) => {
        sticky.classList.toggle("is-hidden-by-form", entry.isIntersecting);
      }, { threshold: 0.05 }).observe(form);
    });
  </script>
</Layout>
